{
 "format_version": "1.2",
 "terraform_version": "1.9.0",
 "resource_changes": [
  {
   "address": "aws_db_instance.orders",
   "type": "aws_db_instance",
   "name": "orders",
   "change": {
    "actions": [
     "delete",
     "create"
    ],
    "before": {
     "storage_encrypted": true,
     "publicly_accessible": false
    },
    "after": {
     "storage_encrypted": false,
     "publicly_accessible": true
    }
   }
  },
  {
   "address": "aws_s3_bucket.logs",
   "type": "aws_s3_bucket",
   "name": "logs",
   "change": {
    "actions": [
     "delete"
    ],
    "before": {
     "bucket": "logs"
    },
    "after": null
   }
  },
  {
   "address": "aws_security_group_rule.ssh",
   "type": "aws_security_group_rule",
   "name": "ssh",
   "change": {
    "actions": [
     "create"
    ],
    "before": null,
    "after": {
     "type": "ingress",
     "cidr_blocks": [
      "0.0.0.0/0"
     ],
     "from_port": 22,
     "to_port": 22,
     "protocol": "tcp"
    }
   }
  },
  {
   "address": "aws_security_group.web",
   "type": "aws_security_group",
   "name": "web",
   "change": {
    "actions": [
     "update"
    ],
    "before": {
     "ingress": []
    },
    "after": {
     "ingress": [
      {
       "cidr_blocks": [
        "10.0.0.0/8"
       ],
       "from_port": 443,
       "to_port": 443,
       "protocol": "tcp"
      },
      {
       "cidr_blocks": [
        "0.0.0.0/0"
       ],
       "from_port": 0,
       "to_port": 0,
       "protocol": "-1"
      }
     ]
    }
   }
  },
  {
   "address": "aws_iam_policy.admin",
   "type": "aws_iam_policy",
   "name": "admin",
   "change": {
    "actions": [
     "create"
    ],
    "before": null,
    "after": {
     "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": \"*\", \"Resource\": \"*\"}]}"
    }
   }
  },
  {
   "address": "aws_iam_policy.reader",
   "type": "aws_iam_policy",
   "name": "reader",
   "change": {
    "actions": [
     "create"
    ],
    "before": null,
    "after": {
     "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": \"arn:aws:s3:::logs/*\"}]}"
    }
   }
  },
  {
   "address": "aws_s3_bucket_acl.site",
   "type": "aws_s3_bucket_acl",
   "name": "site",
   "change": {
    "actions": [
     "update"
    ],
    "before": {
     "acl": "private"
    },
    "after": {
     "acl": "public-read"
    }
   }
  },
  {
   "address": "aws_s3_bucket_public_access_block.site",
   "type": "aws_s3_bucket_public_access_block",
   "name": "site",
   "change": {
    "actions": [
     "update"
    ],
    "before": {
     "block_public_acls": true
    },
    "after": {
     "block_public_acls": false,
     "block_public_policy": true
    }
   }
  },
  {
   "address": "aws_ebs_volume.data",
   "type": "aws_ebs_volume",
   "name": "data",
   "change": {
    "actions": [
     "create"
    ],
    "before": null,
    "after": {
     "encrypted": false,
     "size": 100
    }
   }
  },
  {
   "address": "aws_instance.app",
   "type": "aws_instance",
   "name": "app",
   "change": {
    "actions": [
     "update"
    ],
    "before": {
     "instance_type": "t3.small"
    },
    "after": {
     "instance_type": "t3.medium"
    }
   }
  },
  {
   "address": "aws_s3_bucket.assets",
   "type": "aws_s3_bucket",
   "name": "assets",
   "change": {
    "actions": [
     "no-op"
    ],
    "before": {
     "bucket": "assets"
    },
    "after": {
     "bucket": "assets"
    }
   }
  }
 ]
}